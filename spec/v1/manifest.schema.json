{
  "$defs": {
    "MissingKind": {
      "description": "A kind the Trigify API offers no operation for: none of its objects could be harvested\n(`reason` says why); a fallback export can fill it later.",
      "properties": {
        "kind": {
          "enum": [
            "org",
            "integration",
            "credit_ledger_entry",
            "usage_record",
            "search",
            "search_result",
            "monitor",
            "monitor_result",
            "monitor_post_result",
            "topic",
            "topic_engagement",
            "target_list",
            "target",
            "signal_subscription",
            "signal",
            "insight",
            "workflow",
            "workflow_draft",
            "run",
            "output_row",
            "workflow_table",
            "workflow_table_row",
            "list",
            "list_member",
            "agent_memory_table",
            "agent_memory_record",
            "legacy_route"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source": {
          "const": "missing",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "reason"
      ],
      "title": "MissingKind",
      "type": "object"
    },
    "Redaction": {
      "description": "Where the writer replaced credentials in one object by the redaction marker: the paths\nonly (dot-joined; a renamed key appears as the marker), never the values.",
      "properties": {
        "kind": {
          "enum": [
            "org",
            "integration",
            "credit_ledger_entry",
            "usage_record",
            "search",
            "search_result",
            "monitor",
            "monitor_result",
            "monitor_post_result",
            "topic",
            "topic_engagement",
            "target_list",
            "target",
            "signal_subscription",
            "signal",
            "insight",
            "workflow",
            "workflow_draft",
            "run",
            "output_row",
            "workflow_table",
            "workflow_table_row",
            "list",
            "list_member",
            "agent_memory_table",
            "agent_memory_record",
            "legacy_route"
          ],
          "title": "Kind",
          "type": "string"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "trigify_id": {
          "minLength": 1,
          "title": "Trigify Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "trigify_id",
        "paths"
      ],
      "title": "Redaction",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`signal_types`: Signal types the workspace used; `not_used`: kinds of a feature Trigify\nanswered as never used (403/404); `not_listed`: kinds the Harvester had no source listing\nfor; `not_available`: Trigify routes that answered 404. All `[]` in 1.0.0 manifests.\n`missing`: kinds the API cannot reach; `redactions`: per object, where credentials were\nredacted, in write order. Both `[]` before 1.2.0. From 1.3.0 `not_available` holds any\nroute that answered 403 or 404.",
  "properties": {
    "counts": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "org",
          "integration",
          "credit_ledger_entry",
          "usage_record",
          "search",
          "search_result",
          "monitor",
          "monitor_result",
          "monitor_post_result",
          "topic",
          "topic_engagement",
          "target_list",
          "target",
          "signal_subscription",
          "signal",
          "insight",
          "workflow",
          "workflow_draft",
          "run",
          "output_row",
          "workflow_table",
          "workflow_table_row",
          "list",
          "list_member",
          "agent_memory_table",
          "agent_memory_record",
          "legacy_route"
        ]
      },
      "title": "Counts",
      "type": "object"
    },
    "missing": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MissingKind"
      },
      "title": "Missing",
      "type": "array"
    },
    "not_available": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Not Available",
      "type": "array"
    },
    "not_listed": {
      "default": [],
      "items": {
        "enum": [
          "org",
          "integration",
          "credit_ledger_entry",
          "usage_record",
          "search",
          "search_result",
          "monitor",
          "monitor_result",
          "monitor_post_result",
          "topic",
          "topic_engagement",
          "target_list",
          "target",
          "signal_subscription",
          "signal",
          "insight",
          "workflow",
          "workflow_draft",
          "run",
          "output_row",
          "workflow_table",
          "workflow_table_row",
          "list",
          "list_member",
          "agent_memory_table",
          "agent_memory_record",
          "legacy_route"
        ],
        "type": "string"
      },
      "title": "Not Listed",
      "type": "array"
    },
    "not_used": {
      "default": [],
      "items": {
        "enum": [
          "org",
          "integration",
          "credit_ledger_entry",
          "usage_record",
          "search",
          "search_result",
          "monitor",
          "monitor_result",
          "monitor_post_result",
          "topic",
          "topic_engagement",
          "target_list",
          "target",
          "signal_subscription",
          "signal",
          "insight",
          "workflow",
          "workflow_draft",
          "run",
          "output_row",
          "workflow_table",
          "workflow_table_row",
          "list",
          "list_member",
          "agent_memory_table",
          "agent_memory_record",
          "legacy_route"
        ],
        "type": "string"
      },
      "title": "Not Used",
      "type": "array"
    },
    "redactions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Redaction"
      },
      "title": "Redactions",
      "type": "array"
    },
    "signal_types": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Signal Types",
      "type": "array"
    },
    "spec_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Spec Version",
      "type": "string"
    },
    "trigify_workspace_id": {
      "minLength": 1,
      "title": "Trigify Workspace Id",
      "type": "string"
    },
    "workspace_label": {
      "minLength": 1,
      "title": "Workspace Label",
      "type": "string"
    },
    "writer_version": {
      "minLength": 1,
      "title": "Writer Version",
      "type": "string"
    },
    "written_at": {
      "format": "date-time",
      "pattern": "Z$",
      "title": "Written At",
      "type": "string"
    }
  },
  "required": [
    "spec_version",
    "writer_version",
    "trigify_workspace_id",
    "workspace_label",
    "written_at",
    "counts"
  ],
  "title": "Manifest",
  "type": "object",
  "x-trekk-spec-version": "1.3.0"
}
